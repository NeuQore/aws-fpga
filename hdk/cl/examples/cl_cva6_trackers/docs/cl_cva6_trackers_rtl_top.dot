// RTL hierarchy for cl_cva6_trackers.
//
//   cd $CL_DIR/docs
//   dot -Tpng -Gdpi=140 cl_cva6_trackers_rtl_top.dot -o cl_cva6_trackers_rtl_top.png
digraph cl_cva6_trackers_rtl_top {
  rankdir=TB;
  compound=true;
  splines=spline;
  nodesep=0.35;
  ranksep=0.55;
  pad=0.30;
  bgcolor="white";
  fontname="Helvetica";

  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        penwidth=1.4, margin="0.16,0.10", color="#90a4ae", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=9, fontcolor="#546e7a",
        color="#78909c", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_cl {
    label=<<B>cl_cva6_trackers.sv</B>  MAGIC 0xC6A66402  DID 0xF0C8>;
    fontname="Helvetica";
    fontsize=13;
    fontcolor="#2e7d32";
    labelloc=t;
    style="rounded,filled";
    fillcolor="#e8f5e9";
    color="#2e7d32";
    penwidth=1.6;

    ocl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>OCL AXI-Lite FSM</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">clk_main_a0 250 MHz</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">CTRL · TRACE_* @ 0x20–0x74</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#c8e6c9", color="#2e7d32"];

    div [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>clk_div /4</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">clk_cpu 62.5 MHz</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#c8e6c9", color="#2e7d32"];

    subgraph cluster_soc {
      label=<<B>cva6_f2_soc.sv</B>  clk_cpu>;
      fontname="Helvetica";
      fontsize=12;
      fontcolor="#ef6c00";
      labelloc=t;
      style="rounded,filled";
      fillcolor="#fff8e1";
      color="#ef6c00";
      penwidth=1.6;

      core [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
              <TR><TD><B>ariane / CVA6</B></TD></TR>
              <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">cv64a6_imafdc_sv39</FONT></TD></TR>
              <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">wt_cache_subsystem  I$ + D$</FONT></TD></TR>
              <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">RVFI probes  hit_o / miss_o</FONT></TD></TR>
            </TABLE>>,
            fillcolor="#ffe0b2", color="#ef6c00"];

      xbar [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
              <TR><TD><B>axi_xbar</B></TD></TR>
              <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">64-bit AXI4</FONT></TD></TR>
            </TABLE>>,
            fillcolor="#ffe0b2", color="#ef6c00"];

      peri [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
              <TR><TD><B>Peripherals</B></TD></TR>
              <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546e7a">DRAM master → HBM</FONT></TD></TR>
              <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546e7a">host_uart · clint · plic</FONT></TD></TR>
            </TABLE>>,
            fillcolor="#ffecb3", color="#ef6c00"];

      cap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
             <TR><TD><B>cva6_trace_capture</B></TD></TR>
             <TR><TD><FONT POINT-SIZE="9" COLOR="#c62828">cycle_q · in_window · packers</FONT></TD></TR>
             <TR><TD><FONT POINT-SIZE="9" COLOR="#c62828">SEL 0–4 mux → TRACE_RDATA</FONT></TD></TR>
           </TABLE>>,
           fillcolor="#ffcdd2", color="#c62828"];

      rams [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
              <TR><TD><B>cva6_trace_ram × 5</B></TD></TR>
              <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c62828">instr 1024 × 1024b</FONT></TD></TR>
              <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c62828">I$ AXI + D$ AXI 1024 × 512b</FONT></TD></TR>
              <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c62828">events 256 × 1024b</FONT></TD></TR>
              <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c62828">L1 lookups 2048 × 256b</FONT></TD></TR>
              <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">wr clk_cpu · rd clk_main_a0</FONT></TD></TR>
            </TABLE>>,
            fillcolor="#ef9a9a", color="#c62828"];

      core -> xbar [color="#ef6c00"];
      xbar -> peri [color="#ef6c00"];
      core -> cap [label="RVFI", color="#c62828", fontcolor="#c62828"];
      peri -> cap [label="DRAM AXI snoop", color="#c62828", fontcolor="#c62828"];
      cap -> rams [color="#c62828"];
    }

    mux [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>cva6_hbm_mux</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#00695c">PCIS if cpu_run=0 · CPU if 1</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#b2dfdb", color="#00695c"];

    dw [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD><B>axi_dw_converter</B></TD></TR>
          <TR><TD><FONT POINT-SIZE="9" COLOR="#00695c">64 → 512 bit</FONT></TD></TR>
        </TABLE>>,
        fillcolor="#b2dfdb", color="#00695c"];

    hbm [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>HBM wrapper  1 GiB</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#00695c">CVA6 0x8000_0000</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#80cbc4", color="#00695c"];

    ocl -> cap [lhead=cluster_soc, label="TRACE_*  CDC", color="#2e7d32"];
    div -> core [lhead=cluster_soc, color="#ef6c00"];
    peri -> mux [color="#00695c"];
    mux -> dw -> hbm [color="#00695c"];
  }
}
