// Instruction tracker — hardware packer + host dump.
//
//   cd $CL_DIR/docs
//   dot -Tpng -Gdpi=140 cl_cva6_trackers_instr.dot -o cl_cva6_trackers_instr.png
digraph cl_cva6_trackers_instr {
  rankdir=LR;
  compound=true;
  splines=spline;
  nodesep=0.35;
  ranksep=0.70;
  pad=0.30;
  bgcolor="white";
  fontname="Helvetica";

  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        penwidth=1.4, margin="0.16,0.10", color="#90a4ae", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=9, fontcolor="#546e7a",
        color="#78909c", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_hw {
    label=<<B>Hardware  clk_cpu</B>  windowed>;
    fontname="Helvetica";
    fontsize=13;
    fontcolor="#c62828";
    labelloc=t;
    style="rounded,filled";
    fillcolor="#ffebee";
    color="#c62828";
    penwidth=1.6;

    rvfi [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD><B>CVA6 RVFI</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">commit ports 0 / 1</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">PC · fu_op · trans_id 0–7</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">rd_wdata · priv · minstret</FONT></TD></TR>
          </TABLE>>,
          fillcolor="#ffcdd2", color="#c62828"];

    pack [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD><B>pack_instr()</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">16 × 64-bit record</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">1-entry skid if dual-issue</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">no live LSU VA/PA</FONT></TD></TR>
          </TABLE>>,
          fillcolor="#ffcdd2", color="#c62828"];

    ram [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>instr BRAM</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">1024 deep · INSTR_OVF</FONT></TD></TR>
           <TR><TD><FONT FACE="Courier" POINT-SIZE="9" COLOR="#546e7a">TRACE_SEL=0</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#ef9a9a", color="#c62828"];

    rvfi -> pack -> ram [color="#c62828"];
  }

  subgraph cluster_sw {
    label=<<B>Software  run_cva6_trackers</B>>;
    fontname="Helvetica";
    fontsize=13;
    fontcolor="#1565c0";
    labelloc=t;
    style="rounded,filled";
    fillcolor="#e3f2fd";
    color="#1565c0";
    penwidth=1.6;

    peek [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD><B>TRACE_INSTR_CNT @ 0x40</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">read_record(sel=0)</FONT></TD></TR>
          </TABLE>>,
          fillcolor="#bbdefb", color="#1565c0"];

    dis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>dump_instr_csv</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">fetch insn from .bin at PC−0x80000000</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">ABI names · imm · GPR replay</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">unused / unknown → NONE</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#bbdefb", color="#1565c0"];

    csv [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>instr.csv</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">cycle pc op insn trans_id</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">rs1/2_val rd imm retire minstret</FONT></TD></TR>
         </TABLE>>,
         shape=note, fillcolor="#ffffff", color="#1565c0"];

    peek -> dis -> csv [color="#1565c0"];
  }

  ram -> peek [color="#c62828", label="OCL RDATA"];
}
