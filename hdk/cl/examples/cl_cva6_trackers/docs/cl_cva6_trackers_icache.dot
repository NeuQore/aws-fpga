// I-cache DRAM AXI tracker — hardware snoop + host decode.
//
//   cd $CL_DIR/docs
//   dot -Tpng -Gdpi=140 cl_cva6_trackers_icache.dot -o cl_cva6_trackers_icache.png
digraph cl_cva6_trackers_icache {
  rankdir=LR;
  compound=true;
  splines=spline;
  nodesep=0.35;
  ranksep=0.70;
  pad=0.30;
  bgcolor="white";
  fontname="Helvetica";

  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        penwidth=1.4, margin="0.16,0.10", color="#90a4ae", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=9, fontcolor="#546e7a",
        color="#78909c", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_hw {
    label=<<B>Hardware  clk_cpu</B>  windowed · DRAM only>;
    fontname="Helvetica";
    fontsize=13;
    fontcolor="#6a1b9a";
    labelloc=t;
    style="rounded,filled";
    fillcolor="#f3e5f5";
    color="#6a1b9a";
    penwidth=1.6;

    axi [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>master[DRAM]</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">AR / R  ID[0]==0</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">I$ refill toward HBM</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#e1bee7", color="#6a1b9a"];

    pack [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD><B>pack_cache()</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">8 × 64-bit  kind AR/R</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">PA from AR table · beat data</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">va field is 0 on AXI</FONT></TD></TR>
          </TABLE>>,
          fillcolor="#e1bee7", color="#6a1b9a"];

    ram [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>I-cache BRAM</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">1024 deep · IC_OVF</FONT></TD></TR>
           <TR><TD><FONT FACE="Courier" POINT-SIZE="9" COLOR="#546e7a">TRACE_SEL=1</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#ce93d8", color="#6a1b9a"];

    axi -> pack -> ram [color="#6a1b9a"];
  }

  subgraph cluster_sw {
    label=<<B>Software  dump_cache_csv(sel=1)</B>>;
    fontname="Helvetica";
    fontsize=13;
    fontcolor="#1565c0";
    labelloc=t;
    style="rounded,filled";
    fillcolor="#e3f2fd";
    color="#1565c0";
    penwidth=1.6;

    peek [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD><B>TRACE_IC_CNT @ 0x44</B></TD></TR>
          </TABLE>>,
          fillcolor="#bbdefb", color="#1565c0"];

    dec [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>R-beat decode</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">disassemble refill bytes</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">carry across 16-bit C.insns</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">AR→R latency</FONT></TD></TR>
         </TABLE>>,
         fillcolor="#bbdefb", color="#1565c0"];

    csv [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD><B>icache.csv</B></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">cycle kind va line pa beat</FONT></TD></TR>
           <TR><TD><FONT POINT-SIZE="9" COLOR="#546e7a">data decode strb bytes latency</FONT></TD></TR>
         </TABLE>>,
         shape=note, fillcolor="#ffffff", color="#1565c0"];

    peek -> dec -> csv [color="#1565c0"];
  }

  ram -> peek [color="#6a1b9a", label="OCL RDATA"];
}
